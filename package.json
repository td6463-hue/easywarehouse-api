{
  "name": "easy-warehouse-api",
  "version": "1.0.1",
  "type": "module",
  "description": "Easy Warehouse Node.js + Express + TypeScript + Swagger API",
  "main": "dist/index.js",
  "scripts": {
    "swagger": "tsx src/scripts/swagger-autogen.ts",
    "predev": "npm run swagger",
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "release:patch": "npm version patch -m \"chore: release v%s\" && git push origin main --tags",
    "release:minor": "npm version minor -m \"chore: release v%s\" && git push origin main --tags",
    "release:major": "npm version major -m \"chore: release v%s\" && git push origin main --tags"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.7",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "swagger-autogen": "^2.23.7",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  }
}
